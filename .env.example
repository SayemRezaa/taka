# Supabase project settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Supabase project settings -> Database -> Connection string -> Transaction pooler
# Port 6543. Append ?pgbouncer=true
# A literal % in the password must be written as %25, or the driver mis-parses
# the URL. Do not keep the [ ] brackets from Supabase's placeholder.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Comma-separated Supabase user ids allowed to use the MCP endpoint at
# /api/mcp. Supabase > Authentication > Users > your row > User UID.
# Empty or missing means nobody is allowed, including you: a deploy that
# forgets this locks the door rather than opening it to any signed-up user.
MCP_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000
